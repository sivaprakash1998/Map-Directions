# Copy to .env for local overrides. Anything PUBLIC_-prefixed is exposed to the
# browser, so never put a secret in this file.

# Routing backend for the road route and turn-by-turn directions, as an OSRM
# route service base URL. Leave unset to use the public OSRM demo server, which
# is rate limited and explicitly not for production traffic.
PUBLIC_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
