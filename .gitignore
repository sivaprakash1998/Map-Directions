# Dependencies
node_modules
.pnpm-store
jspm_packages

# Build output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build
/dist

# Env — keep secrets and machine-specific config out, but track the templates
.env
.env.*
!.env.example
!.env.test

# Local HTTPS certificates (npm run dev:phone generates a self-signed pair)
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12

# Caches
.vite
.cache
.turbo
.parcel-cache
.eslintcache
.stylelintcache
*.tsbuildinfo

# Logs
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test and coverage output
/coverage
.nyc_output
/test-results
/playwright-report
/playwright/.cache
/blob-report

# Editors — .vscode/extensions.json is tracked on purpose
.idea
*.iml
*.code-workspace
.history
*.swp
*.swo
*~

# OS cruft
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Scratch files
tmp
temp
*.tmp
*.bak
*.orig
*.rej

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
